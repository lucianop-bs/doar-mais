<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doarmais.controller.UsuarioController">
   <top>
      <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1000.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="label-title" text="Gerenciamento de Usuários" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" styleClass="pane-card" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="tableUsuarios" prefHeight="450.0" prefWidth="700.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome" />
                  <TableColumn fx:id="colEmail" prefWidth="250.0" text="Email" />
                  <TableColumn fx:id="colAdmin" prefWidth="100.0" text="Admin" />
              </columns>
            </TableView>
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <right>
      <VBox prefHeight="420.0" prefWidth="280.0" spacing="15.0" styleClass="pane-card" BorderPane.alignment="CENTER">
         <children>
            <Label text="Detalhes do Usuário">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <VBox spacing="5.0">
               <children>
                  <Label text="Nome:" />
                  <TextField fx:id="txtNome" prefHeight="35.0" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Email:" />
                  <TextField fx:id="txtEmail" prefHeight="35.0" />
               </children>
            </VBox>
            <CheckBox fx:id="chkAdmin" mnemonicParsing="false" text="Privilégios de Administrador" />
            <VBox spacing="10.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onSalvar" prefHeight="40.0" styleClass="btn-primary" text="SALVAR ALTERAÇÕES" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onRemover" prefHeight="40.0" styleClass="btn-danger" text="EXCLUIR USUÁRIO" />
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </VBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </VBox>
   </right>
   <bottom>
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onVoltar" prefHeight="35.0" prefWidth="150.0" styleClass="btn-warning" text="VOLTAR" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
