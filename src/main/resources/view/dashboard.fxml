<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1300.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doarmais.controller.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="1300.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <Button alignment="CENTER" mnemonicParsing="false" onAction="#voltar" prefHeight="35.0" prefWidth="70.0" styleClass="btn-danger" text="SAIR">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Button>
                <VBox alignment="CENTER_LEFT" prefHeight="118.0" prefWidth="350.0">
                    <children>
                        <Label styleClass="label-title" text="Dashboard DOAR+">
                            <VBox.margin>
                                <Insets left="30.0" />
                            </VBox.margin>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label text="Logado como:">
                                 <HBox.margin>
                                    <Insets left="30.0" />
                                 </HBox.margin>
                              </Label>
                              <Label fx:id="lblUsuarioLogado" styleClass="label-user" text="Usuário" />
                           </children>
                        </HBox>
                        <Label fx:id="lblError" alignment="CENTER" prefHeight="17.0" prefWidth="300.0" textFill="RED" visible="false">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="btnGerenciarUsuarios" alignment="CENTER" mnemonicParsing="false" onAction="#irParaUsuarios" prefHeight="40.0" prefWidth="180.0" styleClass="btn-primary" text="Gerenciar Usuários" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" fillHeight="false" prefHeight="118.0" prefWidth="600.0">
               <children>
                      <Label text="Capacidade de Cestas:">
                          <font>
                              <Font name="System Bold" size="21.0" />
                          </font>
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                      </Label>
                      <Label fx:id="lblTotal" prefHeight="70.0" text="0" textFill="#2196f3">
                          <font>
                              <Font name="System Bold" size="48.0" />
                          </font>
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                      </Label>
               </children>
            </HBox>
            </children>
        </HBox>
    </top>
    <left>
        <VBox prefHeight="550.0" prefWidth="320.0" spacing="10.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Receber Doações">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>
            <VBox spacing="5.0" styleClass="pane-card">
               <children>
                      <Label text="Item:" />
                      <ComboBox fx:id="cbItemDoacao" prefWidth="250.0" />
                      <Label text="Quantidade:" />
                      <Spinner fx:id="spnQtd" prefWidth="120.0" />
                  <HBox spacing="10.0">
                     <children>
                            <Button mnemonicParsing="false" onAction="#onAdicionarPendente" prefHeight="35.0" prefWidth="130.0" styleClass="btn-primary" text="Adicionar" />
                        <Button mnemonicParsing="false" onAction="#onAdicionarCestaCompleta" prefHeight="35.0" prefWidth="130.0" styleClass="btn-success" text="+ Cesta Completa" />
                     </children>
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
            <Label text="Itens na Lista de Entrada:">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <TableView fx:id="tablePendentes" prefHeight="200.0" prefWidth="280.0">
              <columns>
                <TableColumn fx:id="colPenItem" prefWidth="180.0" text="Item" />
                <TableColumn fx:id="colPenQtd" prefWidth="80.0" text="Qtd" />
              </columns>
            </TableView>
            <HBox spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onLimparLista" prefHeight="40.0" prefWidth="130.0" styleClass="btn-warning" text="Limpar Lista" />
                  <Button mnemonicParsing="false" onAction="#onFinalizarRecebimento" prefHeight="40.0" prefWidth="130.0" styleClass="btn-success" text="SALVAR TUDO" />
               </children>
            </HBox>
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </left>
   <center>
      <VBox spacing="15.0">
         <children>
            <HBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Histórico de Doações">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                          <TableView fx:id="tableDoacoes" prefHeight="400.0" prefWidth="320.0">
                              <columns>
                                  <TableColumn fx:id="colItem" prefWidth="80.0" text="Item" />
                                  <TableColumn fx:id="colQtd" prefWidth="70.0" text="Qtd" />
                                  <TableColumn fx:id="colUsuario" prefWidth="80.0" text="Doador" />
                                  <TableColumn fx:id="colData" prefWidth="80.0" text="Data" />
                              </columns>
                          </TableView>
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#onRemover" prefWidth="320.0" styleClass="btn-danger" text="Remover Selecionada">
                           <font>
                              <Font name="System Bold" size="10.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Beneficiários (Entregas)">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TableView fx:id="tableDistribuicoes" prefHeight="400.0" prefWidth="420.0">
                          <columns>
                            <TableColumn fx:id="colBenNome" prefWidth="140.0" text="Beneficiário" />
                            <TableColumn fx:id="colBenQtd" prefWidth="60.0" text="Cestas" />
                              <TableColumn fx:id="colBenData" prefWidth="100.0" text="Data" />
                              <TableColumn fx:id="colBenUser" prefWidth="110.0" text="Por" />
                          </columns>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Estoque Atual">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                          <TableView fx:id="tableItem" prefHeight="400.0" prefWidth="200.0">
                              <columns>
                                  <TableColumn fx:id="colItemNome" prefWidth="130.0" text="Item" />
                                  <TableColumn fx:id="colQtdTotal" prefWidth="60.0" text="Qtd" />
                              </columns>
                          </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox fx:id="paneDistribuir" alignment="CENTER" prefHeight="100.0" prefWidth="900.0" spacing="20.0" styleClass="pane-card">
               <children>
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Distribuir Cestas Básicas">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <Label text="Verifique o estoque antes de realizar a entrega." textFill="#666" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label text="Qtd Cestas:" />
                        <Spinner fx:id="spnQtdDoacao" prefWidth="80.0" />
                        <Label text="Beneficiário:" />
                        <TextField fx:id="txtBeneficiario" prefHeight="35.0" prefWidth="280.0" promptText="Nome Completo do Recebedor" />
                        <Button fx:id="btnDoar" alignment="CENTER" mnemonicParsing="false" onAction="#onDoar" prefHeight="40.0" prefWidth="120.0" styleClass="btn-success" text="DISTRIBUIR" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
