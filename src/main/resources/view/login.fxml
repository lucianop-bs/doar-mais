<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doarmais.controller.LoginController">
    <VBox alignment="CENTER" layoutX="50.0" layoutY="25.0" prefHeight="400.0" prefWidth="300.0" spacing="20.0" styleClass="pane-card">
        <Label styleClass="label-title" text="DoarMais" />
        <VBox spacing="5.0">
            <children>
                <Label text="E-mail:" />
                <TextField fx:id="txtUsuario" prefHeight="35.0" promptText="Digite seu e-mail" />
            </children>
        </VBox>
        <VBox spacing="5.0">
            <children>
                <Label text="Senha:" />
                <PasswordField fx:id="txtSenha" prefHeight="35.0" promptText="Digite sua senha" />
            </children>
        </VBox>
        <Label fx:id="lblError" alignment="CENTER" prefHeight="18.0" prefWidth="216.0" textFill="RED" visible="false" />
        <VBox spacing="10.0">
            <children>
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onEntrarClick" prefHeight="40.0" styleClass="btn-primary" text="ENTRAR" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCadastrarClick" prefHeight="40.0" styleClass="btn-success" text="CADASTRAR" />
            </children>
        </VBox>
    </VBox>
</AnchorPane>
