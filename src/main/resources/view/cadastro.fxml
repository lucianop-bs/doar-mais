<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="450.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.doarmais.controller.CadastroController">
   <children>
      <VBox alignment="CENTER" layoutX="50.0" layoutY="25.0" prefHeight="450.0" prefWidth="350.0" spacing="15.0" styleClass="pane-card">
         <children>
            <Label styleClass="label-title" text="CADASTRO" />
            <Label fx:id="lblError" alignment="CENTER" prefHeight="18.0" prefWidth="300.0" textFill="RED" />
            <VBox spacing="5.0">
               <children>
                  <Label text="Nome Completo:" />
                  <TextField fx:id="txtNome" prefHeight="35.0" promptText="Digite seu nome" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="E-mail:" />
                  <TextField fx:id="txtEmail" prefHeight="35.0" promptText="Digite seu e-mail" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Senha:" />
                  <PasswordField fx:id="txtSenha" prefHeight="35.0" promptText="Crie uma senha forte" />
               </children>
            </VBox>
            <VBox spacing="10.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCadastrarClick" prefHeight="40.0" styleClass="btn-success" text="CONFIRMAR CADASTRO" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#voltar" prefHeight="40.0" styleClass="btn-danger" text="VOLTAR" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
